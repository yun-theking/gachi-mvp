OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# 아래 둘은 로컬 개발에서는 비워둬도 됨 (자동으로 data/gachi.db 로컬 파일 사용).
# Vercel에 배포할 때만 Turso 대시보드에서 발급받은 값을 넣으세요.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# /admin 페이지(전체 데이터 엑셀 다운로드) 접근 비밀번호. 설정 안 하면 /admin 사용 불가.
ADMIN_PASSWORD=

# 선택 기능 (기본 꺼짐). 켜려면 1로 바꾸고 다시 배포하세요. 자세한 내용: lib/features.ts
# 서비스 개선용 답변 사용 동의(설정 화면). 문구는 초안이라 켜기 전에 개인정보 검토가 필요해요.
NEXT_PUBLIC_ENABLE_DATA_CONSENT=
# 답변마다 "그림으로 보기"(OpenAI 이미지 생성, 누를 때마다 비용 발생).
NEXT_PUBLIC_ENABLE_IMAGES=
# 이미지 모델을 바꾸고 싶을 때만 (기본 gpt-image-1)
IMAGE_MODEL=
